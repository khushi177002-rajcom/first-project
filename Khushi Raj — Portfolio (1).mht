.wrap { max-width: 1080px; margin: 0px auto; padding: 0px 24px; }

.eyebrow { font-size: 0.75rem; letter-spacing: 0.14em; color: var(--cyan); font-weight: 600; margin-bottom: 10px; }

section { padding: 90px 0px; }

section h2 { font-size: 1.9rem; margin-bottom: 8px; }

section .lede { color: var(--muted); max-width: 60ch; margin-bottom: 40px; }

nav { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 50; background: rgba(7, 10, 18, 0.7); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }

.navbar { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; max-width: 1080px; margin: 0px auto; }

.logo { font-family: Sora, sans-serif; font-weight: 700; font-size: 1.05rem; }

.navlinks { display: none; gap: 28px; font-size: 0.9rem; color: var(--muted); }

.navlinks a:hover { color: var(--white); }

.burger { display: flex; flex-direction: column; gap: 5px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; padding: 6px; }

.burger span { width: 22px; height: 2px; background: var(--white); display: block; }

.mobmenu { display: none; flex-direction: column; padding: 10px 24px 20px; gap: 14px; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--muted); }

.mobmenu.open { display: flex; }

@media (min-width: 820px) {
  .navlinks { display: flex; }
  .burger { display: none; }
}

.hero { padding: 150px 0px 90px; position: relative; }

.glow { position: absolute; width: 420px; height: 420px; border-radius: 50%; filter: blur(120px); opacity: 0.35; z-index: 0; }

.glow.c1 { background: var(--cyan); top: -80px; right: -100px; }

.glow.c2 { background: var(--purple); bottom: -60px; left: -120px; }

.hero .in { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }

.ring { width: 132px; height: 132px; border-radius: 50%; padding: 3px; background: conic-gradient(var(--cyan),var(--purple),var(--cyan)); }

.ring .inner { width: 100%; height: 100%; border-radius: 50%; background: var(--bg2); border: 2px solid var(--bg); }

.hero h1 { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.01em; }

.hero .role { color: var(--muted); font-size: 1.05rem; max-width: 46ch; }

.hero .intro { color: var(--muted); font-size: 0.98rem; max-width: 56ch; }

.ctarow { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }

.btn { padding: 14px 26px; border-radius: 8px; font-weight: 600; font-size: 0.92rem; transition: transform 0.2s; }

.btn:hover { transform: translateY(-2px); }

.btn.grad { background: linear-gradient(90deg,var(--cyan),var(--purple)); color: rgb(8, 16, 26); box-shadow: 0 0 30px -8px var(--cyan); }

.btn.outline { border: 1px solid var(--card-b); color: var(--white); }

.card { background: var(--card); border: 1px solid var(--card-b); border-radius: 14px; padding: 24px; transition: transform 0.2s, border-color 0.2s; }

.card:hover { transform: translateY(-4px); border-color: rgba(34, 211, 238, 0.35); }

.about-grid { display: grid; gap: 20px; grid-template-columns: 1fr; }

.infolist { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; font-size: 0.9rem; }

.infolist .k { color: var(--muted); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px; }

@media (min-width: 760px) {
  .about-grid { grid-template-columns: 1.1fr 0.9fr; }
}

.tl { border-left: 2px solid var(--card-b); margin-left: 8px; }

.tl-item { position: relative; padding: 0px 0px 34px 28px; }

.tl-item:last-child { padding-bottom: 0px; }

.tl-item::before { content: ""; position: absolute; left: -7px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(90deg,var(--cyan),var(--purple)); }

.tl-item h3 { font-size: 1.05rem; margin-bottom: 4px; }

.tl-item .meta { color: var(--muted); font-size: 0.86rem; margin-bottom: 6px; }

.tl-item .tag { display: inline-block; font-size: 0.74rem; color: var(--cyan); border: 1px solid rgba(34, 211, 238, 0.35); padding: 3px 10px; border-radius: 20px; }

.grid { display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }

@media (min-width: 640px) {
  .grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 900px) {
  .grid { grid-template-columns: repeat(4, 1fr); }
}

.skill h3 { font-size: 0.98rem; margin-bottom: 8px; }

.bar { height: 5px; background: rgba(255, 255, 255, 0.08); border-radius: 6px; overflow: hidden; margin-bottom: 8px; }

.bar i { display: block; height: 100%; background: linear-gradient(90deg,var(--cyan),var(--purple)); }

.skill .lvl { font-size: 0.76rem; color: var(--muted); }

.tagwrap { display: flex; flex-wrap: wrap; gap: 10px; }

.tagwrap span { border: 1px solid var(--card-b); background: var(--card); padding: 9px 16px; border-radius: 20px; font-size: 0.88rem; }

.grid3 { display: grid; gap: 18px; grid-template-columns: 1fr; }

@media (min-width: 700px) {
  .grid3 { grid-template-columns: repeat(3, 1fr); }
}

.proj-grid { display: grid; gap: 18px; grid-template-columns: 1fr; }

@media (min-width: 700px) {
  .proj-grid { grid-template-columns: repeat(2, 1fr); }
}

.proj h3 { font-size: 1.05rem; margin-bottom: 6px; }

.proj p { color: var(--muted); font-size: 0.9rem; margin-bottom: 12px; }

.proj .techs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }

.proj .techs span { font-size: 0.72rem; color: var(--purple); border: 1px solid rgba(167, 139, 250, 0.35); padding: 3px 9px; border-radius: 20px; }

.proj a.view { font-size: 0.86rem; font-weight: 600; color: var(--cyan); }

.ach { border-style: dashed; color: var(--muted); text-align: center; font-size: 0.88rem; }

.contact-grid { display: grid; gap: 24px; grid-template-columns: 1fr; }

@media (min-width: 760px) {
  .contact-grid { grid-template-columns: 0.9fr 1.1fr; }
}

.clinks a { display: block; padding: 12px 0px; border-bottom: 1px solid var(--line); font-size: 0.92rem; }

.clinks a:hover { color: var(--cyan); }

form input, form textarea { width: 100%; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--card-b); color: var(--white); padding: 12px 14px; border-radius: 8px; font-family: inherit; font-size: 0.9rem; margin-bottom: 14px; }

form textarea { resize: vertical; min-height: 100px; }

form button { width: 100%; }

footer { border-top: 1px solid var(--line); padding: 30px 0px; text-align: center; color: var(--muted); font-size: 0.82rem; }

@media (prefers-reduced-motion: reduce) {
  .card, .btn { transition: none; }
}
